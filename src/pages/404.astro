---
// src/pages/404.astro
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Página no encontrada | IMPRIMEVERS"
  description="La página que buscas no existe. Vuelve a la landing de IMPRIMEVERS o cotiza tu idea."
  noindex
>
  <main id="main" class="min-h-screen flex items-center justify-center px-4 py-24 bg-cyber-black">
    <div class="max-w-lg w-full text-center cyber-glass border border-cyber-blue/40 rounded-3xl p-8 sm:p-12 space-y-6">
      <div class="font-orbitron font-black text-6xl text-transparent bg-clip-text bg-linear-to-r from-cyber-blue via-cyber-purple to-cyber-red">
        404
      </div>
      <h1 class="font-orbitron font-black text-2xl text-white">Esta capa no existe</h1>
      <p class="text-slate-400 text-sm">
        La página que buscas se perdió en el vacío. Vuelve al inicio o cotiza tu idea directamente.
      </p>
      <div class="flex flex-wrap justify-center gap-3 pt-2">
        <a href="/" class="px-5 py-3 rounded-xl bg-linear-to-r from-cyber-blue via-cyber-purple to-cyber-red text-white font-orbitron font-bold text-xs tracking-wider">
          VOLVER AL INICIO
        </a>
        <a href="/#builder" class="px-5 py-3 rounded-xl cyber-glass border border-slate-700 text-slate-200 font-orbitron font-bold text-xs tracking-wider hover:border-cyber-blue transition">
          COTIZAR MI IDEA
        </a>
      </div>
    </div>
  </main>
</Layout>
