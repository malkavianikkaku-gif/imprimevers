---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import SlicerSimulator from '../components/SlicerSimulator.astro';
import Story from '../components/Story.astro';
import LabTech from '../components/LabTech.astro';
import Portfolio from '../components/Portfolio.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Packages from '../components/Packages.astro';
import QuoteBuilder from '../components/QuoteBuilder.astro';
import LeadForm from '../components/LeadForm.astro';
import FAQ from '../components/FAQ.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import Footer from '../components/Footer.astro';
import { FAQS } from '../data/faq';
---

<Layout title="IMPRIMEVERS | Impresión 3D en Cuernavaca, Morelos" faq={FAQS}>
  <Navbar />
  <main id="main">
    <Hero />
    <SlicerSimulator />
    <Story />
    <LabTech />
    <Portfolio />
    <HowItWorks />
    <Packages />
    <QuoteBuilder />
    <LeadForm />
    <FAQ />
    <WhatsAppFloat />
  </main>

  <Footer />
</Layout>
