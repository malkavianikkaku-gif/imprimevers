---
// src/components/WhatsAppFloat.astro
import { whatsappUrl } from '../config/site';
---

<a
  href={whatsappUrl()}
  target="_blank"
  rel="noopener noreferrer"
  data-wa="float"
  aria-label="Escríbenos por WhatsApp"
  class="hidden md:flex fixed bottom-6 left-6 z-50 w-14 h-14 rounded-full bg-cyber-black/90 border border-emerald-500/40 text-emerald-400 items-center justify-center hover:scale-110 transition duration-300 shadow-[0_0_16px_rgba(52,211,153,0.25)]"
>
  <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
  </svg>
</a>

<div class="fixed bottom-0 left-0 right-0 z-50 md:hidden">
  <a
    href={whatsappUrl()}
    target="_blank"
    rel="noopener noreferrer"
    data-wa="float-bar"
    aria-label="Escríbenos por WhatsApp"
    class="flex w-full items-center justify-center gap-3 bg-cyber-black/90 border-t border-emerald-500/30 px-6 py-4 text-emerald-400 font-orbitron font-bold text-xs tracking-widest"
  >
    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
    </svg>
    <span>ESCRÍBENOS POR WHATSAPP</span>
  </a>
</div>
