---
// src/components/Portfolio.astro
import Icon from './Icon.astro';

const galleryItems = [
  {
    title: 'FNAF & Minecraft Chibis',
    category: 'IMPRESIÓN FDM • FLEXIBLE / COLECCIONABLE',
    description: 'Figuras articuladas de 5 a 12g diseñadas para resistencia al uso diario. Alto volumen y encanto en tamaño de bolsillo.',
    image: '/images/gallery/fnaf-chibis.png', 
    tag: 'PLA+ / 15 MXN',
    color: 'border-cyber-purple/30 group-hover:border-cyber-purple text-cyber-purple'
  },
  {
    title: 'Dragones y Criaturas Articuladas',
    category: 'PIEZAS FLEXIBLES • ANTI-ESTRÉS',
    description: 'Impresión en lotes optimizados en cama completa para garantizar encaje perfecto sin soportes complejos.',
    image: '/images/gallery/dragones-flex.jpeg',
    tag: 'PLA+ / Multicolor',
    color: 'border-cyber-blue/30 group-hover:border-cyber-blue text-cyber-blue'
  },
  {
    title: 'Gatito Tierno',
    category: 'PLA • FIGURA ESTÁTICA',
    description: 'Figura estática de un gato impresa en PLA. Una pieza de escritorio sencilla y tierna, ideal para regalo.',
    image: '/images/gallery/gatito.jpeg',
    tag: 'PLA',
    color: 'border-cyber-purple/30 group-hover:border-cyber-purple text-cyber-purple'
  },
  {
    title: 'Metagross Articulado',
    category: 'BLENDER 3D • ENSAMBLAJE',
    description: 'Modelo totalmente articulado con tolerancias mecánicas aplicadas con imprimevers_tools para un acople perfecto.',
    image: '/images/gallery/metagross.jpeg',
    tag: 'Tolerancia 0.3mm',
    color: 'border-cyber-purple/30 group-hover:border-cyber-purple text-cyber-purple'
  },
  {
    title: 'Onix Flexible',
    category: 'POKÉMON • PIEZA FLEXIBLE',
    description: 'Onix de Pokémon impreso en material flexible y en buen tamaño, pensado para exhibirse o manipularse.',
    image: '/images/gallery/onix.jpeg',
    tag: 'Flexible',
    color: 'border-cyber-blue/30 group-hover:border-cyber-blue text-cyber-blue'
  },
  {
    title: 'Endevor (El Enderman Colosal)',
    category: 'BLOCKBENCH & BLENDER • LORE PROPIO',
    description: 'Mutación de 4 brazos y 4 tentáculos nacida de absorber el aliento de la dragona. Co-creación con Bobonsam.',
    image: '/images/gallery/endevor.png',
    tag: 'Proyecto Especial',
    color: 'border-cyber-red/30 group-hover:border-cyber-red text-cyber-red'
  },
  {
    title: 'Tumba de Halloween',
    category: 'HALLOWEEN • ADORNO EN PROCESO',
    description: 'Adorno de Halloween que Bobonsam está pintando a mano. Una pieza decorativa del taller que sigue en proceso.',
    image: '/images/gallery/tumba.jpeg',
    tag: 'En pintura',
    color: 'border-cyber-red/30 group-hover:border-cyber-red text-cyber-red'
  }
];
---

<section id="portfolio" class="py-24 relative bg-cyber-black border-t border-cyber-cardBorder overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    
    <!-- Encabezado de la sección -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div class="space-y-3 max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyber-purple/15 border border-cyber-purple/40 text-cyber-purple font-mono text-xs font-semibold">
          <Icon name="image" class="w-4 h-4" /> PASARELA DE FOTOS • TALLER IMPRIMEVERS
        </div>
        <h2 class="font-orbitron font-black text-3xl sm:text-5xl text-white tracking-tight">
          Materializaciones Reales
        </h2>
        <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
          Explora la colección de piezas y figuras. <span class="text-cyber-blue font-semibold">Haz clic en cualquier imagen para ampliarla en detalle.</span>
        </p>
      </div>

      <!-- Botones de Navegación de la Pasarela -->
      <div class="flex items-center gap-3 self-start md:self-end">
        <button id="scrollLeft" aria-label="Anterior" class="w-12 h-12 rounded-2xl bg-cyber-black border border-slate-800 text-white flex items-center justify-center hover:border-cyber-blue hover:text-cyber-blue hover:shadow-[0_0_15px_rgba(0,229,255,0.3)] transition duration-300 cursor-pointer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        </button>
        <button id="scrollRight" aria-label="Siguiente" class="w-12 h-12 rounded-2xl bg-cyber-black border border-slate-800 text-white flex items-center justify-center hover:border-cyber-blue hover:text-cyber-blue hover:shadow-[0_0_15px_rgba(0,229,255,0.3)] transition duration-300 cursor-pointer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>

    <!-- Pasarela / Carrusel deslizable -->
    <div id="galleryContainer" class="flex gap-6 overflow-x-auto snap-x snap-mandatory scrollbar-none py-4 scroll-smooth">
      {galleryItems.map((item) => (
        <div class={`min-w-[300px] sm:min-w-[380px] snap-start cyber-glass rounded-3xl overflow-hidden border ${item.color} group transition duration-500 shadow-xl flex flex-col justify-between`}>
          
          <!-- Contenedor de la Imagen con centrado profesional y efecto click para ampliar -->
          <div 
            class="h-72 relative overflow-hidden bg-slate-950 flex items-center justify-center p-3 cursor-zoom-in gallery-trigger"
            data-img-src={item.image}
            data-img-title={item.title}
          >
            <div class="absolute inset-0 bg-cyber-grid opacity-10 pointer-events-none"></div>
            
            <img 
              src={item.image} 
              alt={item.title}
              class="max-w-full max-h-full object-contain rounded-xl group-hover:scale-105 transition duration-500 ease-out shadow-md"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            
            <!-- Visual de repuesto si no existe la foto -->
            <div class="hidden absolute inset-0 bg-slate-900 flex-col items-center justify-center p-6 text-center space-y-2">
              <Icon name="box" class="w-12 h-12 text-slate-600" />
              <span class="font-orbitron font-bold text-slate-400 text-xs">{item.title}</span>
              <span class="text-[10px] font-mono text-slate-500">Agrega tu foto en {item.image}</span>
            </div>
            
            <!-- Badge superior -->
            <span class="absolute top-4 right-4 px-2.5 py-1 rounded-full bg-cyber-black/80 backdrop-blur-md border border-white/10 text-white text-[10px] font-mono shadow-md pointer-events-none">
              {item.tag}
            </span>

            <!-- Indicador visual de zoom al pasar el mouse -->
            <div class="absolute inset-0 bg-cyber-purple/10 opacity-0 group-hover:opacity-100 transition duration-300 flex items-center justify-center pointer-events-none">
              <span class="px-3 py-1.5 rounded-xl bg-cyber-black/80 text-white font-mono text-xs border border-cyber-purple/50 shadow-lg flex items-center gap-1.5">
                <Icon name="image" class="w-3.5 h-3.5 text-cyber-purple" /> Ver en grande
              </span>
            </div>
          </div>

          <!-- Información del proyecto -->
          <div class="p-6 space-y-3">
            <span class="text-[10px] font-mono font-semibold tracking-wider text-slate-400 uppercase block">
              {item.category}
            </span>
            <h3 class="font-orbitron font-bold text-xl text-white group-hover:text-cyber-blue transition duration-300">
              {item.title}
            </h3>
            <p class="text-slate-300 text-xs leading-relaxed font-light">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<!-- MODAL LIGHTBOX PARA AMPLIAR FOTOS -->
<div id="imageModal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-xl hidden items-center justify-center p-4 sm:p-8">
  <button id="closeModal" aria-label="Cerrar visor" class="absolute top-6 right-6 w-12 h-12 rounded-2xl bg-cyber-card border border-slate-700 text-white flex items-center justify-center hover:border-cyber-red hover:text-cyber-red transition cursor-pointer z-10">
    <Icon name="x" class="w-6 h-6" />
  </button>
  <div class="max-w-5xl w-full max-h-[90vh] flex flex-col items-center justify-center space-y-4 relative">
    <img id="modalImg" src="" alt="Ampliación" class="max-w-full max-h-[75vh] object-contain rounded-2xl border border-cyber-cardBorder shadow-[0_0_30px_rgba(0,229,255,0.2)]" />
    <h3 id="modalTitle" class="font-orbitron font-bold text-lg sm:text-xl text-white tracking-wider text-center"></h3>
  </div>
</div>

<script>
  // Script para scroll horizontal y Lightbox de imágenes
  const container = document.getElementById('galleryContainer');
  const scrollLeftBtn = document.getElementById('scrollLeft');
  const scrollRightBtn = document.getElementById('scrollRight');

  if (container && scrollLeftBtn && scrollRightBtn) {
    scrollLeftBtn.addEventListener('click', () => {
      container.scrollBy({ left: -380, behavior: 'smooth' });
    });
    scrollRightBtn.addEventListener('click', () => {
      container.scrollBy({ left: 380, behavior: 'smooth' });
    });
  }

  // Lógica del Lightbox (Ampliar imagen)
  const modal = document.getElementById('imageModal');
  const modalImg = document.getElementById('modalImg') as HTMLImageElement;
  const modalTitle = document.getElementById('modalTitle');
  const closeModal = document.getElementById('closeModal');

  document.querySelectorAll('.gallery-trigger').forEach((card) => {
    card.addEventListener('click', () => {
      const src = card.getAttribute('data-img-src');
      const title = card.getAttribute('data-img-title');
      if (modal && modalImg && modalTitle && src) {
        modalImg.src = src;
        modalTitle.innerText = title || '';
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden'; // Bloquear scroll de fondo
      }
    });
  });

  function closeLightbox() {
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = 'auto';
    }
  }

  closeModal?.addEventListener('click', closeLightbox);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>

<style>
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>