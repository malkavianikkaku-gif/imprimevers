---
// src/components/LeadForm.astro
import Icon from './Icon.astro';
---

<section id="lead-section" class="py-24 relative bg-cyber-black text-white border-t border-cyber-cardBorder overflow-hidden">
  <div class="absolute top-1/3 right-0 w-[500px] h-[300px] bg-cyber-blue/10 rounded-full blur-[150px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10 relative z-10">
    <div class="text-center space-y-3 max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyber-blue/15 border border-cyber-blue/40 text-cyber-blue font-mono text-xs">
        <Icon name="megaphone" class="w-4 h-4" /> ÚLTIMO PASO
      </div>
      <h2 class="font-orbitron font-black text-3xl sm:text-4xl text-white">
        Cuéntanos tu idea
      </h2>
      <p class="text-slate-400 text-sm max-w-xl mx-auto">
        Déjanos tus datos y tu idea. Te redirigimos a WhatsApp para que el taller la materialice.
      </p>
    </div>

    <div class="cyber-glass p-6 sm:p-10 rounded-3xl border border-cyber-cardBorder shadow-2xl max-w-2xl mx-auto">
      <form id="lead-form" class="space-y-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div class="space-y-2">
            <label for="lead-name" class="text-xs font-mono text-slate-400 block">Tu nombre *</label>
            <input type="text" id="lead-name" name="name" required class="w-full bg-cyber-black border border-slate-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-cyber-purple text-sm font-mono" />
          </div>
          <div class="space-y-2">
            <label for="lead-email" class="text-xs font-mono text-slate-400 block">Tu email *</label>
            <input type="email" id="lead-email" name="email" required class="w-full bg-cyber-black border border-slate-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-cyber-purple text-sm font-mono" />
          </div>
        </div>

        <div class="space-y-2">
          <label for="lead-city" class="text-xs font-mono text-slate-400 block">Ciudad</label>
          <input type="text" id="lead-city" name="city" class="w-full bg-cyber-black border border-slate-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-cyber-purple text-sm font-mono" />
        </div>

        <div class="space-y-2">
          <label for="lead-idea" class="text-xs font-mono text-slate-400 block">Tu idea *</label>
          <textarea id="lead-idea" name="idea" rows="4" required class="w-full bg-cyber-black border border-slate-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-cyber-purple text-sm font-mono resize-none"></textarea>
        </div>

        <div class="space-y-2">
          <label for="lead-file" class="text-xs font-mono text-slate-400 block">Referencia / archivo (opcional)</label>
          <input type="file" id="lead-file" name="file" class="w-full text-slate-400 file:bg-cyber-card file:border file:border-slate-700 file:rounded-xl file:px-4 file:py-2 file:font-mono file:text-xs" />
        </div>

        <button
          type="submit"
          class="w-full py-4 rounded-xl bg-linear-to-r from-cyber-blue via-cyber-purple to-cyber-red text-white font-orbitron font-bold text-xs tracking-widest shadow-lg hover:opacity-95 transition flex items-center justify-center gap-2 cursor-pointer"
        >
          <Icon name="send" class="w-4 h-4" /> ENVIAR DATOS POR WHATSAPP
        </button>
        <p class="text-[10px] font-mono text-slate-400 text-center">
          No se guarda nada: se abrirá WhatsApp con tu idea y los datos de contacto. Si envías archivo, el taller lo gestionará desde la app de WhatsApp Business.
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  import { whatsappUrl } from '../config/site';

  function handleLeadSubmit(event: SubmitEvent) {
    event.preventDefault();
    const name = (document.getElementById('lead-name') as HTMLInputElement | null)?.value.trim() || 'Anónimo';
    const email = (document.getElementById('lead-email') as HTMLInputElement | null)?.value.trim() || 'Sin email';
    const city = (document.getElementById('lead-city') as HTMLInputElement | null)?.value.trim() || 'Cuernavaca';
    const idea = (document.getElementById('lead-idea') as HTMLTextAreaElement | null)?.value.trim() || '';
    const file = (document.getElementById('lead-file') as HTMLInputElement | null)?.files?.[0];

    const msg = [
      '¡Hola Malvavysco y Bobonsam! Quiero enviarles mi idea para IMPRIMEVERS:',
      `- Nombre: ${name}`,
      `- Email: ${email}`,
      `- Ciudad: ${city}`,
      `- Idea: ${idea}`,
      file ? `- Referencia: ${file.name}` : '- Referencia: No adjunto',
      '',
      'Con gusto te cotizamos y te confirmamos si podemos materializarla.',
    ].join('\n');

    const url = whatsappUrl(msg);
    const popup = window.open(url, '_blank');
    if (popup) {
      try {
        popup.opener = null;
      } catch {
        // El navegador puede bloquear el acceso; el enlace ya se abrió.
      }
    } else {
      window.location.href = url;
    }
  }

  function setupLeadForm() {
    const form = document.getElementById('lead-form');
    if (form) form.addEventListener('submit', handleLeadSubmit);
  }

  document.addEventListener('astro:page-load', setupLeadForm);
  setupLeadForm();
</script>
