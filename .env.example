# Copia este archivo como `.env` y pega tus IDs reales.
# `.env` está en .gitignore, así que no se sube al repositorio.
#
# Dónde encontrar cada ID:
# - GA4: Administrador > Flujos de datos > tu sitio web > "ID de medición".
# - Meta: Events Manager > Orígenes de datos > tu píxel > "ID del píxel".
#
# Déjalos vacíos si todavía no tienes las cuentas: el sitio funciona igual.

PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=
